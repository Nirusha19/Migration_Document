# GitHub Migration Tool Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# GitHub API Configuration
# You can set a default GitHub token here (optional)
# GITHUB_TOKEN=your_github_personal_access_token

# Document Generation
# Maximum number of commits to fetch per request
MAX_COMMITS_PER_REQUEST=100

# File Storage
# Directory where generated documents will be stored
DOCUMENTS_DIR=./documents

# CORS Configuration
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
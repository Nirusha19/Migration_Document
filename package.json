{
  "name": "github-migration-documentation-tool",
  "version": "1.0.0",
  "description": "A tool to connect with GitHub.com and generate migration documentation for Angular applications",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "npm run clean && npm run compile",
    "clean": "rm -rf dist",
    "compile": "tsc",
    "lint": "eslint src/**/*.js",
    "test": "jest"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "@octokit/auth-token": "^4.0.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12",
    "fs-extra": "^11.1.1",
    "lodash": "^4.17.21",
    "json2csv": "^6.1.0",
    "marked": "^9.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0"
  },
  "keywords": [
    "github",
    "migration",
    "documentation",
    "angular",
    "git",
    "history"
  ],
  "author": "GitHub Migration Tool",
  "license": "MIT"
}

{
  "name": "github-migration-documentation-tool",
  "version": "1.0.0",
  "description": "A tool to connect with GitHub.com and generate migration documentation for Angular applications",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "server": "node server/app.js",
    "dev": "nodemon src/index.js",
    "build": "npm run clean && npm run compile",
    "clean": "rm -rf dist",
    "compile": "tsc",
    "lint": "eslint src/**/*.js",
    "test": "jest"
  },
  "dependencies": {
    "@octokit/rest": "^19.0.13",
    "@octokit/auth-token": "^3.0.4",
    "commander": "^10.0.1",
    "dotenv": "^16.1.4",
    "moment": "^2.29.4",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "fs-extra": "^11.1.1",
    "lodash": "^4.17.21",
    "json2csv": "^5.0.7",
    "marked": "^5.1.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "eslint": "^8.44.0",
    "jest": "^29.6.1"
  },
  "keywords": [
    "github",
    "migration",
    "documentation",
    "angular",
    "git",
    "history"
  ],
  "author": "GitHub Migration Tool",
  "license": "MIT"
}

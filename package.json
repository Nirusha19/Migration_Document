    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "octokit": "^3.1.2",
    "moment": "^2.29.4",
    "pdfkit": "^0.14.0",
    "exceljs": "^4.4.0",
    "axios": "^1.6.0",
    "simple-git": "^3.20.0",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "github",
    "migration",
    "documentation",
    "api"
